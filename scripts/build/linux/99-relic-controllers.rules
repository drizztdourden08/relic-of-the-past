# @layer tooling-scripts @kind build
# Relic of the Past — game controller access (Linux)
#
# Grants the logged-in desktop user read/write access to game controllers over
# hidraw + USB, so the SDL3 controller transport can open them without root.
# `TAG+="uaccess"` hands access to the active seat's user via systemd-logind
# (the modern, group-free approach).
#
# Installed automatically by the .deb (see deb-postinst.sh); AppImage users copy
# this file to /etc/udev/rules.d/ manually (see docs/controllers/linux-setup.md).

# Nintendo (Switch Pro / Pro 2 / NSO GameCube / Joy-Con)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="057e", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="057e", TAG+="uaccess"

# Sony (DualShock 4 / DualSense)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="054c", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="054c", TAG+="uaccess"

# Microsoft (Xbox — usually XInput, included for completeness)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="045e", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="045e", TAG+="uaccess"

# 8BitDo
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2dc8", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="2dc8", TAG+="uaccess"
