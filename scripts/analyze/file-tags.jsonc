{
  // Central tag manifest. Authoritative over in-file headers and heuristics.
  // Use for: (1) files that cannot hold a comment (JSON, binaries, asm),
  //          (2) bulk-tagging trees we must not edit (vendored upstream).
  // Format: "<glob>": { "layer"?, "kind"?, "vendored"? }   later/more matches merge.

  "core/zelda3/**":           { "layer": "core-zelda3", "vendored": true },
  "core/zelda3/**/*.c":       { "kind": "native" },
  "core/zelda3/**/*.h":       { "kind": "native" },

  "core/game-hooks/**":       { "layer": "core-game-hooks", "kind": "native" },
  "core/wasm-build/**/*.c":   { "layer": "core-wasm-build", "kind": "native" },

  "**/*.json":                { "kind": "config-data" },
  "**/*.jsonc":               { "kind": "config" },
  "**/*.html":                { "kind": "config" },
  "**/*.txt":                 { "kind": "doc" },

  // Binary / non-text assets (cannot carry a header comment).
  "**/*.png":   { "kind": "asset" },
  "**/*.jpg":   { "kind": "asset" },
  "**/*.jpeg":  { "kind": "asset" },
  "**/*.gif":   { "kind": "asset" },
  "**/*.ico":   { "kind": "asset" },
  "**/*.svg":   { "kind": "asset" },
  "**/*.icns":  { "kind": "asset" },
  "**/*.wav":   { "kind": "asset" },
  "**/*.ttf":   { "kind": "asset" },
  "**/*.woff":  { "kind": "asset" },
  "**/*.woff2": { "kind": "asset" },
  "**/*.dat":   { "kind": "asset" },
  "**/*.sfc":   { "kind": "asset" },
  // Emulator save states are test fixtures and cannot carry a header comment.
  "**/*.sav":   { "kind": "asset" },

  "apps/web/public/**":   { "kind": "asset" },
  // Generated Emscripten output, mirrored for the desktop shell (gitignored).
  "apps/desktop/public/wasm/**": { "kind": "asset" },
  // Named save states the tests + nav baselines load; documented in their README.
  "tests/fixtures/save-states/**": { "kind": "asset" },
  // Kept (permanent) app-driven specs. Documented in tests/e2e/README.md.
  "tests/e2e/**": { "kind": "test" },
  // The folder's own README is prose, or the rule above would lint it as a test.
  "tests/e2e/*.md": { "kind": "doc" },

  "shared/game/data/**":      { "kind": "data" },
  "shared/input/data/**":     { "kind": "data" },
  "shared/asset-extraction/**/data/**": { "kind": "data" },
  "**/*.data.ts":             { "kind": "data" },

  // Root files that cannot carry an in-file tag comment.
  "LICENSE":                  { "layer": "root-config", "kind": "doc" },
  ".nvmrc":                   { "layer": "root-config", "kind": "config" },

  // GitHub community health files & workflows (issue templates carry YAML
  // frontmatter, so they cannot hold an in-file tag comment).
  ".github/**/*.md":          { "layer": "root-config", "kind": "doc" },
  ".github/**/*.yml":         { "layer": "root-config", "kind": "config" },

  // Git hooks (shell scripts, no extension).
  ".githooks/**":             { "layer": "tooling-scripts", "kind": "logic" },

  // Per-version release notes. GitHub release bodies come from these.
  "release-notes/**":         { "layer": "root-config", "kind": "doc" }
}
