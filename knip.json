{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreDependencies": [],
  "workspaces": {
    ".": {
      "entry": [
        "brock.workspace.mjs"
      ]
    },
    "apps/desktop": {
      "entry": [
        "electron/main.ts",
        "electron/preload.ts",
        "src/main.tsx",
        "src/ipc/contract.type.ts",
        "src/screens/**/*.custom.tsx",
        "src/**/*.usage.ts",
        "tests/**/*.{ts,tsx}",
        ".brock/*.ts",
        "*.config.{cjs,ts,mjs}",
        "brock.config.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "electron/**/*.ts",
        "tests/**/*.{ts,tsx}",
        ".brock/*.ts"
      ],
      "ignoreDependencies": [
        "@capacitor/android",
        "@capacitor/cli",
        "@capacitor/assets",
        "@capacitor/haptics",
        "@capacitor-community/keep-awake",
        "vite-plugin-node-polyfills",
        "@rotp/workspace"
      ]
    },
    "apps/sanctuary": {
      "entry": [
        "brock.site.ts",
        "src/**/*.usage.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "apps/store": {
      "entry": [
        "brock.site.ts",
        "src/**/*.usage.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/*": {}
  }
}
