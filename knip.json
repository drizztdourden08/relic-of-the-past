{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreDependencies": [],
  "ignoreFiles": [
    "**/index.ts",
    "packages/navigation/src/pathfinding/**",
    "apps/store-api/src/window-api.type.ts",
    "apps/desktop/src/game/msu-session/msu-window.type.ts",
    "packages/randomizer/src/client/local-session-items/**"
  ],
  "ignoreIssues": {
    "packages/randomizer/src/audit/**": ["exports", "types"],
    "packages/game-data/src/data/taxonomy/*-tags.type.ts": ["types"],
    "apps/desktop/src/data-inspector/recommendations/recommendation-cache/index.ts": ["exports"],
    "apps/desktop/src/game/index.ts": ["exports", "types"],
    "apps/desktop/src/game/delivery-api/**": ["exports", "types"],
    "apps/desktop/src/game/receipt-grants/**": ["exports", "types"],
    "packages/game-core/src/wasm-bridge/index.ts": ["exports", "types"],
    "packages/game-core/src/bridge/**": ["exports", "types"],
    "packages/navigation/src/pathfinding/**": ["exports", "types"],
    "packages/randomizer/src/delivery-execute/**": ["exports", "types"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "brock.workspace.mjs",
        "standards.config.mjs",
        ".markdownlint-cli2.mjs",
        "core/wasm-build/*.mjs",
        "tooling/ensure-linux-sdl3-soname.mjs"
      ],
      "ignoreDependencies": [
        "clang-format-node"
      ]
    },
    "tooling/apworld": {
      "entry": [
        "ensure-apworld.mjs",
        "pack-apworld.mjs",
        "run-exporter.mjs",
        "write-player-file.mjs",
        "write-public-builds.mjs"
      ]
    },
    "tooling/gba-alttp-re": {
      "entry": [
        "*.mjs",
        "build-playable-assets.ts",
        "export-palace-dungeon.ts"
      ]
    },
    "apps/desktop": {
      "entry": [
        "electron/main.ts",
        "electron/preload.ts",
        "src/main.tsx",
        "src/ipc/contract.type.ts",
        "src/augment.ts",
        "src/profile.type.ts",
        "src/platform/rotp-platform-ports.type.ts",
        "src/shell/show-rules/show-flags.type.ts",
        "src/screens/**/*.custom.tsx",
        "src/**/*.usage.ts",
        "tests/**/*.{ts,tsx}",
        ".brock/*.ts",
        "*.config.{cjs,ts,mjs}",
        "brock.config.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "electron/**/*.ts",
        "tests/**/*.{ts,tsx}",
        ".brock/*.ts"
      ],
      "ignoreDependencies": [
        "@capacitor/android",
        "@capacitor/cli",
        "@capacitor/assets",
        "@capacitor-community/keep-awake",
        "vite-plugin-node-polyfills",
        "@rotp/workspace",
        "png-to-ico",
        "sharp"
      ]
    },
    "apps/sanctuary": {
      "entry": [
        "brock.site.ts",
        "src/**/*.usage.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "apps/store": {
      "entry": [
        "brock.site.ts",
        "src/**/*.usage.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "vite-plugin-node-polyfills"
      ]
    },
    "apps/website": {
      "entry": [
        "brock.site.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "apps/store-api": {
      "ignoreDependencies": [
        "@aws-sdk/client-s3",
        "@aws-sdk/s3-request-presigner"
      ]
    },
    "apps/sanctuary-api": {
      "ignoreDependencies": [
        "@aws-sdk/client-s3",
        "@aws-sdk/s3-request-presigner"
      ]
    },
    "packages/game-core": {
      "entry": [
        "src/save-state/formats.ts"
      ]
    },
    "packages/design": {
      "entry": [
        "src/**/*.usage.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/randomizer": {
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts"
      ]
    },
    "packages/navigation": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/*": {}
  }
}
