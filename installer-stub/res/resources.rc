// @layer installer @kind config
#include <windows.h>

1 RT_MANIFEST "app.manifest"

1 ICON "app.ico"

// Kept as raw bytes rather than a bitmap so the alpha channel survives; the
// painter decodes it and scales it per screen.
101 RCDATA "logo-256.png"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2, 0, 0, 0
PRODUCTVERSION 2, 0, 0, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Relic of the Past"
      VALUE "FileDescription", "Relic of the Past Setup"
      VALUE "FileVersion", "2.0.0.0"
      VALUE "InternalName", "relic-setup"
      VALUE "OriginalFilename", "relic-setup.exe"
      VALUE "ProductName", "Relic of the Past"
      VALUE "ProductVersion", "2.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
