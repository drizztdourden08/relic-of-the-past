{
  "extends": "@drizztdourden08/brock-lint-config/tsconfig/react.json",
  "compilerOptions": {
    "types": [
      "node",
      "vite/client"
    ],
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@app/*": [
        "./apps/desktop/src/*"
      ],
      "@domains/*": [
        "./apps/desktop/src/ui/domains/*"
      ],
      "@site-kit/*": [
        "./apps/site-kit/*"
      ]
    }
  },
  "include": [
    "apps/desktop/src/**/*",
    "apps/sanctuary/src/**/*",
    "apps/store/src/**/*",
    "apps/site-kit/**/*",
    "apps/desktop/electron/**/*",
    "packages/*/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "out",
    "core"
  ]
}
