{
  "extends": "@drizztdourden08/brock-lint-config/tsconfig/react.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@shared/*": ["./shared/*"],
      "@app/*": ["./apps/web/src/*"],
      "@ds/*": ["./apps/web/src/ui/design-system/*"],
      "@domains/*": ["./apps/web/src/ui/domains/*"],
      "@site-kit/*": ["./apps/site-kit/*"]
    }
  },
  "include": [
    "apps/web/src/**/*",
    "apps/sanctuary/src/**/*",
    "apps/store/src/**/*",
    "apps/site-kit/**/*",
    "apps/desktop/electron/**/*",
    "shared/**/*"
  ],
  "exclude": ["node_modules", "dist", "out", "core"]
}
