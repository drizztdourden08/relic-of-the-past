{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"],
      "@app/*": ["apps/desktop/src/*"]
    }
  },
  "include": [
    "apps/desktop/src/**/*",
    "apps/desktop/electron/**/*",
    "shared/**/*"
  ],
  "exclude": ["node_modules", "dist", "out", "core"]
}
