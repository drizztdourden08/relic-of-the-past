  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "../hub-core", "../../shared/hub", "../../shared/sanctuary"],
  "exclude": ["../hub-core/node_modules"]
}
