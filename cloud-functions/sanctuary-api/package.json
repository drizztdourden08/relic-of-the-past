{
  "name": "sanctuary-api-function",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/index.js --external:@google-cloud/* --external:@aws-sdk/* --loader:.svg=text",
    "typecheck": "tsc --noEmit",
    "start": "functions-framework --target=sanctuaryApi --source=dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@google-cloud/firestore": "catalog:",
    "@google-cloud/functions-framework": "catalog:",
    "arctic": "catalog:",
    "jose": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@rotp/hub-contracts": "workspace:*",
    "esbuild": "catalog:",
    "typescript": "catalog:functions"
  }
}
