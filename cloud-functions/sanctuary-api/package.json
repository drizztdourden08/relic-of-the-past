{
  "name": "sanctuary-api-function",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/index.js --external:@google-cloud/* --external:@aws-sdk/*",
    "typecheck": "tsc --noEmit",
    "start": "functions-framework --target=sanctuaryApi --source=dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@google-cloud/firestore": "^7.9.0",
    "@google-cloud/functions-framework": "^3.4.0",
    "arctic": "^3.0.0",
    "jose": "^6.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
