# Implementation plans (working docs, never committed)
/plans

# MCP config (contains secrets — bot tokens, API keys)
.mcp.json

# Dependencies
node_modules/

# Build output
dist/
out/
# electron-builder reads `build/` as buildResources, so it holds packaging SOURCES
# (the installer splash) as well as output. The pattern has to match the contents
# rather than the directory, or git never descends far enough to see the exception.
/build/*
!/build/installer-splash.gif
*.tsbuildinfo
.wiki-build/

# WASM build artifacts
core/wasm-build/output/

# Downloaded native build dependencies (SDL3, libusb) — fetched by
# scripts/build/fetch-sdl3.mjs, never committed.
third_party/

# SDL3 native controller-input addon build output. build/ was previously
# ignored only by accident (release/ below matches Release/ case-insensitively
# on Windows) — spelled out explicitly so it's not an accident. prebuilds/ is
# scripts/ensure-sdl3.mjs's downloaded-or-locally-built payload.
apps/desktop/electron/input/native/sdl3/build/
apps/desktop/electron/input/native/sdl3/prebuilds/

apps/web/public/wasm/
apps/desktop/public/wasm/

# Extracted sprites (generated at runtime)
apps/web/public/sprites/

# Electron
release/

# Capacitor / Android build artifacts (native project is committed; output is not)
apps/mobile/android/.gradle/
apps/mobile/android/build/
apps/mobile/android/app/build/
apps/mobile/android/app/src/main/assets/public/
apps/mobile/android/local.properties
apps/mobile/android/.idea/
apps/mobile/android/capacitor-cordova-android-plugins/
# Launcher icons + splash are generated at build time from apps/mobile/assets/logo.png
# by `@capacitor/assets` (npm run cap:sync) — the source is committed, the output is not.
apps/mobile/android/app/src/main/res/mipmap-*/ic_launcher*.png
apps/mobile/android/app/src/main/res/mipmap-anydpi-v26/ic_launcher*.xml
apps/mobile/android/app/src/main/res/drawable*/splash.png
# SDL's own Java classes are staged into the build dir straight from the pinned
# SDL3 source (app/build.gradle: stageSdlJava), never copied into this repo. A
# copy here would be someone else's code to maintain by hand and could silently
# fall out of step with the native library it pairs with — so if one ever
# appears, it is a mistake, and this keeps it from being committed.
apps/mobile/android/app/src/main/java/org/

# Assets (user-provided)
assets/assets.dat
assets/*.sfc
assets/*.smc

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/settings.json
.idea/

# Test ROMs (user-provided, never committed)
test-roms/

# Environment
.env
.env.local
.env.*.local

# Local deploy target config (VM SSH details — per machine, never committed)
scripts/deploy/vm.json
# Local push SSH public key (per machine, never committed)
scripts/deploy/*.pub

# Logs
*.log
npm-debug.log*

# Debug dumps (--dump-layers / --dump-nav output, never committed)
debug-output/

# Session transcripts (never committed)
transcript-*.jsonl

# Playwright test artifacts
playwright-report/
test-results/
tests/test-results/
tests/screenshots/
# Ephemeral Playwright specs (write, run, delete — never committed)
tests/scratch/
# Ephemeral Vitest tests — throwaway by default, same as Playwright specs above.
# A permanent one carries a .keep.test.ts suffix instead of .test.ts and is
# excepted below. See docs/contributing/testing.md.
tests/**/*.test.ts
!tests/**/*.keep.test.ts

# Temporary/throwaway scripts (not tracked)
temp-scripts/

# Saves (user data)
saves/
!apps/desktop/electron/saves/
seeds/
config/
scripts/analyze/report.json
.claude/worktrees/

# Per-worktree isolated user data (the app's --user-data flag points here)
.user-data/

# Loop scheduler transient lock
.claude/scheduled_tasks.lock

# Claude config — managed in the private claude-config repo, never committed here
.claude/
CLAUDE.md

# AI config — managed in the private ai-config repo, never committed here
.ai-config.json
.ai/
AGENTS.md
.github/copilot-instructions.md

.claude/settings.json
.codex/config.toml

# ── Private vault (rotp-vault) ──
# Game-derived material lives in a private companion repo and is synced in by
# scripts/vault/sync.mjs. None of it is ever committed here. A clone WITHOUT
# vault access still builds, lints and passes the unit tests.
#
# The vault is a sibling checkout, not a clone inside this tree — its `tree/`
# folder mirrors the paths below, which is the whole mapping.
shared/game/data/records/
tests/fixtures/save-states/
.claude/nav-baselines/

# Merge base for the two-sided sync — local state, never shared.
.vault-state.json
