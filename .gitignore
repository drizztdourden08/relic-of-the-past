# Every folder that needs ignoring is a dot-folder, and the .*/ line below
# ignores them all, at any depth. A dot-folder the repo tracks gets a ! line
# here. Never add a line for a single dot-folder: .*/ already covers it.
.*/
!.github/
!.changeset/
!.vscode/
.vscode/*
!.vscode/extensions.json
!.vscode/copilot-instructions.md
!.brock/
.brock/profile-config.json
!.githooks/

# Implementation plans (working docs, never committed)
/plans

# MCP config (contains bot tokens and API keys)
.mcp.json

# Dependencies
node_modules/

# Build output
dist/
out/
# electron-builder reads `build/` as buildResources, so it holds packaging SOURCES
# (the installer splash) and output. The pattern has to match the contents
# instead of the directory, or git never descends far enough to see the exception.
/build/*
!/build/installer-splash.gif
__pycache__/
*.tsbuildinfo

# Brock generated outputs: brock icons and brock package write these
**/build/icons/
**/build/splash/
**/build/installer-splash.png
**/public/logos/icon.svg
**/public/logos/icon.ico
**/public/logos/icon-256.png
**/public/logos/icon-32.png
**/public/logos/icon-24.png
**/public/logos/icon-bot.svg
**/public/logos/icon-bot.ico
**/public/logos/icon-bot-256.png
**/public/logos/mark.svg

# WASM build artifacts
core/wasm-build/output/

# Downloaded native build dependencies (SDL3, libusb). Fetched by
# scripts/build/fetch-sdl3.mjs and never committed.
third_party/

# SDL3 native controller-input addon build output. build/ is listed on purpose
# (release/ below only matches Release/ case-insensitively on Windows). prebuilds/
# is scripts/ensure-sdl3.mjs's downloaded-or-locally-built payload.
apps/desktop/electron/input/native/sdl3/build/
apps/desktop/electron/input/native/sdl3/prebuilds/

apps/desktop/public/wasm/

# Extracted sprites (generated at runtime)
apps/desktop/public/sprites/

# Electron
release/

# Capacitor / Android build artifacts (native project is committed; output is not)
apps/desktop/mobile/android/build/
apps/desktop/mobile/android/app/build/
apps/desktop/mobile/android/app/src/main/assets/public/
apps/desktop/mobile/android/local.properties
apps/desktop/mobile/android/capacitor-cordova-android-plugins/
# SDL's own Java classes are staged into the build dir from the pinned SDL3
# source (app/build.gradle: stageSdlJava), never copied into this repo. A copy
# here would drift from the native library it pairs with, so one appearing is a
# mistake and must not be committed.
apps/desktop/mobile/android/app/src/main/java/org/

# Assets (user-provided)
assets/assets.dat
assets/*.sfc
assets/*.smc

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Test ROMs (user-provided, never committed)
/test-roms/

# Environment
.env
.env.local
.env.*.local

# Per-machine deploy target config (VM SSH details), never committed
scripts/deploy/vm.json
# Local push SSH public key (per machine, never committed)
scripts/deploy/*.pub

# Logs
*.log
npm-debug.log*

# Debug dumps (--dump-layers / --dump-nav output, never committed)
debug-output/

# Session transcripts (never committed)
transcript-*.jsonl

# Playwright test artifacts
playwright-report/
test-results/
tests/test-results/
tests/screenshots/
# Ephemeral Playwright specs (write, run, delete). Never committed.
tests/scratch/
# Ephemeral Vitest tests, throwaway by default like the Playwright specs above.
# A permanent one carries a .keep.test.ts suffix instead of .test.ts and is
# excepted below. See docs/contributing/testing.md.
tests/**/*.test.ts
!tests/**/*.keep.test.ts

# Temporary/throwaway scripts (not tracked)
temp-scripts/

# Saves (user data)
/saves/
# Local ROM-derived WASM harness assets and imported save states.
core/wasm-build/assets/
/seeds/
/config/
scripts/analyze/report.json

# Per-worktree port slots (shared/config/port-slot.ts, and the Brock thread CLI's)
.rotp-port-slot
.brock-port-slot

# Claude config lives in the private claude-config repo and is never committed here
CLAUDE.md

# AI config lives in the private ai-config repo and is never committed here
.ai-config.json
AGENTS.md
.github/copilot-instructions.md

# Private vault (rotp-vault)
# Only ROM-derived binary fixtures live in the private companion repo now, synced in
# by scripts/vault/sync.mjs. The transcribed dataset (shared/game/data/records/) and
# nav baselines are plain text and are tracked directly in this repo instead.
# A clone WITHOUT vault access still builds, lints and passes the unit tests; only the
# save-state-backed tests skip.
#
# The vault is a sibling checkout, not a clone inside this tree. Its `tree/`
# folder mirrors the paths below, and that is the whole mapping.
tests/fixtures/save-states/

# Merge base for the two-sided sync. It is local state and never shared.
.vault-state.json

# Derived .msul document icon (built by scripts/build/make-msul-icon.mjs)
apps/desktop/public/logos/generated/
