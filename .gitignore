# Dependencies
node_modules/

# Build output
dist/
out/
/build/
*.tsbuildinfo

# WASM build artifacts
core/wasm-build/output/
apps/desktop/public/wasm/

# Extracted sprites (generated at runtime)
apps/desktop/public/sprites/

# Electron
release/

# Assets (user-provided)
assets/assets.dat
assets/*.sfc
assets/*.smc

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/settings.json
.idea/

# Test ROMs (user-provided, never committed)
test-roms/

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Playwright test artifacts
playwright-report/
test-results/
tests/test-results/
tests/screenshots/
# Ephemeral Playwright specs (write, run, delete — never committed)
tests/scratch/

# Temporary/throwaway scripts (not tracked)
temp-scripts/

# Saves (user data)
saves/
!apps/desktop/electron/saves/
seeds/
config/
scripts/utils/classification-report.csv
