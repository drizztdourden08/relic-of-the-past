# Implementation plans (working docs, never committed)
/plans

# Dependencies
node_modules/

# Build output
dist/
out/
/build/
*.tsbuildinfo
.wiki-build/

# WASM build artifacts
core/wasm-build/output/
apps/web/public/wasm/

# Extracted sprites (generated at runtime)
apps/web/public/sprites/

# Electron
release/

# Capacitor / Android build artifacts (native project is committed; output is not)
apps/mobile/android/.gradle/
apps/mobile/android/build/
apps/mobile/android/app/build/
apps/mobile/android/app/src/main/assets/public/
apps/mobile/android/local.properties
apps/mobile/android/.idea/
apps/mobile/android/capacitor-cordova-android-plugins/
# Launcher icons + splash are generated at build time from apps/mobile/assets/logo.png
# by `@capacitor/assets` (npm run cap:sync) — the source is committed, the output is not.
apps/mobile/android/app/src/main/res/mipmap-*/ic_launcher*.png
apps/mobile/android/app/src/main/res/mipmap-anydpi-v26/ic_launcher*.xml
apps/mobile/android/app/src/main/res/drawable*/splash.png

# Assets (user-provided)
assets/assets.dat
assets/*.sfc
assets/*.smc

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/settings.json
.idea/

# Test ROMs (user-provided, never committed)
test-roms/

# Environment
.env
.env.local
.env.*.local

# Local deploy target config (VM SSH details — per machine, never committed)
scripts/deploy/vm.json
# Local push SSH public key (per machine, never committed)
scripts/deploy/*.pub

# Logs
*.log
npm-debug.log*

# Debug dumps (--dump-layers / --dump-nav output, never committed)
debug-output/

# Session transcripts (never committed)
transcript-*.jsonl

# Playwright test artifacts
playwright-report/
test-results/
tests/test-results/
tests/screenshots/
# Ephemeral Playwright specs (write, run, delete — never committed)
tests/scratch/

# Temporary/throwaway scripts (not tracked)
temp-scripts/

# Saves (user data)
saves/
!apps/desktop/electron/saves/
seeds/
config/
scripts/analyze/report.json
.claude/worktrees/

# Loop scheduler transient lock
.claude/scheduled_tasks.lock
