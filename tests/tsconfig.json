{
  "extends": "@drizztdourden08/brock-lint-config/tsconfig/react.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "paths": {
      "@app/*": ["../apps/desktop/src/*"],
      "@drizztdourden08/brock-react": ["../apps/desktop/node_modules/@drizztdourden08/brock-react/src/index.ts"],
      "@drizztdourden08/brock-core": ["../apps/desktop/node_modules/@drizztdourden08/brock-core/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["fixtures", "scratch", "screenshots", "test-results"]
}
