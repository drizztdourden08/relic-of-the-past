{
  "extends": "stylelint-config-standard",
  "rules": {
    "no-descending-specificity": null,
    "custom-property-pattern": null,
    "selector-class-pattern": null,
    "keyframes-name-pattern": null,
    "alpha-value-notation": null,
    "color-function-notation": null,
    "value-keyword-case": null
  },
  "overrides": [
    {
      "comment": "App + design-system CSS must use design tokens only — no raw colors. hex/named/rgb()/rgba()/hsl() are all blocked; use var(--c-*)/var(--color-*). The few dynamic per-instance opacity frames (tracker/widget) opt out per-line with a stylelint-disable comment.",
      "files": ["apps/web/src/ui/**/*.css"],
      "rules": {
        "color-no-hex": true,
        "color-named": "never",
        "function-disallowed-list": ["rgb", "rgba", "hsl", "hsla", "hwb"],
        "declaration-property-value-disallowed-list": {
          "font-weight": ["/^[0-9]+$/"],
          "font-size": ["/[0-9]+(px|rem|em|vh|vw|vmin|vmax|%|ch|pt)/"],
          "z-index": ["/^[1-9][0-9]*$/"],
          "/^border(-[a-z]+)?-radius$/": ["/[0-9]+px/"],
          "/^(padding|margin|gap|row-gap|column-gap)(-(top|right|bottom|left))?$/": ["/[0-9]+px/"]
        }
      }
    },
    {
      "comment": "Token definition files are where raw color values are allowed to live.",
      "files": ["apps/web/src/ui/design-system/tokens/**/*.css"],
      "rules": {
        "color-no-hex": null,
        "color-named": null,
        "function-disallowed-list": null,
        "declaration-property-value-disallowed-list": null
      }
    },
    {
      "comment": "HUD replicates the in-game interface using the exact SNES palette; its colors are game-accurate, not design tokens, so the color rules do not apply (see CLAUDE.md HUD exception).",
      "files": ["apps/web/src/ui/domains/hud/**/*.css"],
      "rules": {
        "color-no-hex": null,
        "color-named": null,
        "function-disallowed-list": null,
        "declaration-property-value-disallowed-list": null
      }
    }
  ],
  "ignoreFiles": ["**/node_modules/**", "dist/**", "release/**", "apps/web/public/**"]
}
