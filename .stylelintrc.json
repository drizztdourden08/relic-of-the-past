{
  "extends": "stylelint-config-standard",
  "rules": {
    "no-descending-specificity": null,
    "custom-property-pattern": null,
    "selector-class-pattern": null,
    "keyframes-name-pattern": null,
    "alpha-value-notation": null,
    "color-function-notation": null,
    "value-keyword-case": null
  },
  "overrides": [
    {
      "files": ["apps/desktop/src/ui/**/*.css"],
      "rules": {
        "color-no-hex": [true, { "severity": "warning" }],
        "color-named": ["never", { "severity": "warning" }]
      }
    },
    {
      "files": ["apps/desktop/src/ui/design-system/tokens/**/*.css"],
      "rules": {
        "color-no-hex": null,
        "color-named": null
      }
    },
    {
      "comment": "HUD replicates the in-game interface using the exact SNES palette; its colors are game-accurate, not design tokens, so the color rules do not apply (see CLAUDE.md HUD exception).",
      "files": ["apps/desktop/src/ui/domains/hud/**/*.css"],
      "rules": {
        "color-no-hex": null,
        "color-named": null
      }
    }
  ],
  "ignoreFiles": ["**/node_modules/**", "dist/**", "release/**", "apps/desktop/public/**"]
}
