{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/lint-changed.mjs",
            "statusMessage": "Checking coding standards",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/analyze/analyze.mjs --diff --ci",
            "statusMessage": "Analyzing changed files (analyze:ci)",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
