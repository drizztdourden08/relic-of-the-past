{
  "name": "relic-of-the-past",
  "version": "0.21.1",
  "private": true,
  "description": "Relic of the Past, built with Electron, React and WASM",
  "author": {
    "name": "drizztdourden_",
    "email": "drizztdourden08@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/drizztdourden08/relic-of-the-past.git"
  },
  "type": "module",
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "brock dev",
    "build": "brock build",
    "package": "brock package",
    "start": "brock start",
    "start:headless": "brock start -- --no-focus --muted",
    "sync": "brock sync",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm typecheck && eslint . && stylelint \"src/**/*.css\" && brock prose && brock knip --workspace . && jscpd .",
    "lint:md": "markdownlint-cli2",
    "structure": "brock structure --check",
    "deadcode": "brock knip --workspace .",
    "duplicates": "jscpd .",
    "build:web": "brock web build",
    "dev:web": "brock web dev"
  },
