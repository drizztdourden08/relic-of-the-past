  "portKit": {
    "wasm": {
      "sourceDirs": [
        "../../core/zelda3/src",
        "../../core/zelda3/snes",
        "../../core/game-hooks",
        "../../core/wasm-build"
      ],
      "sourceExtensions": [
        ".c",
        ".h",
        ".mjs"
      ],
      "buildScript": "../../core/wasm-build/build.mjs",
      "output": "public/wasm",
      "outputExtensions": [
        ".wasm",
        ".js"
      ],
      "emsdkDir": "../../third_party/emsdk"
    }
  }
