{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "electron/main.ts",
    "electron/preload.ts",
    "src/main.tsx",
    "src/ipc/contract.type.ts",
    "src/screens/**/*.custom.tsx",
    ".brock/*.ts",
    "*.config.{cjs,ts,mjs}",
    ".markdownlint-cli2.mjs",
    "brock.config.ts",
    "brock.workspace.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "electron/**/*.ts",
    ".brock/*.ts"
  ],
  "ignoreDependencies": [
    "@drizztdourden08/standards",
    "@capacitor/core",
    "@capacitor/android",
    "@capacitor/cli",
    "@capacitor/assets"
  ]
}
