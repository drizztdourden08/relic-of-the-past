{
  "kind": "container",
  "id": "dpad-group",
  "$comment": "a d-pad direction has no glyph of its own, so its item IS its cell - lifted unchanged from the shipped default layout.",
  "layout": "grid",
  "columns": [
    "auto"
  ],
  "rows": [
    "auto"
  ],
  "justifyItems": "start",
