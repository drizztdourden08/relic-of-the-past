{
  "kind": "element",
  "id": "key-indicator",
  "$comment": "Same shape again (KEY_ICON.inkRight=7, box 8x8, margin.left = 12-7 = 5), no max-yellow variant, and the row stays RESERVED at 30x8 even while the game hides the counter (key_current === 255) - the switch is the whole point of this preset over a plain row.",
  "element": {
    "type": "switch",
    "cases": [
      {
        "when": "key_current == 255",
        "node": {
          "kind": "element",
          "id": "key-hidden",
          "size": {
            "w": {
              "px": 30
            },
            "h": {
              "px": 8
            }
          },
          "element": {
            "type": "spacer"
          }
        }
      }
    ],
    "otherwise": {
      "kind": "container",
      "id": "key-row",
      "direction": "row",
      "align": "center",
      "children": [
        {
          "kind": "container",
          "id": "key-gutter",
          "size": {
            "w": {
              "px": 12
            },
            "h": {
              "px": 8
            }
          },
          "layout": "grid",
          "columns": [
            "auto"
          ],
          "rows": [
            "auto"
          ],
          "justifyItems": "start",
          "alignItems": "start",
          "children": [
            {
              "kind": "element",
              "id": "key-icon",
              "margin": {
                "left": 5
              },
              "element": {
                "type": "sprite",
                "file": "hud-key-icon",
                "box": {
                  "w": 8,
                  "h": 8
                }
              },
              "place": {
                "column": 1,
                "row": 1
              }
            }
          ]
        },
        {
          "kind": "element",
          "id": "key-gap",
          "size": {
            "w": {
              "px": 2
            },
            "h": {
              "px": 8
            }
          },
          "element": {
            "type": "spacer"
          }
        },
        {
          "kind": "element",
          "id": "key-count",
          "element": {
            "type": "text",
            "value": {
              "from": "data",
              "expr": "key_current"
            },
            "format": {
              "digits": 2,
              "pad": "zero"
            },
            "face": {
              "from": "sprite",
              "set": "hud-digits"
            }
          }
        }
      ]
    }
  }
}
