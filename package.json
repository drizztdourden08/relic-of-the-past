{
  "name": "@rotp/workspace",
  "version": "0.20.7",
  "private": true,
  "description": "Relic of the Past, built with Electron, React and WASM",
  "author": {
    "name": "drizztdourden_",
    "email": "drizztdourden08@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/drizztdourden08/relic-of-the-past.git"
  },
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "config": {
    "emsdk": "5.0.7"
  },
  "scripts": {
    "postinstall": "pnpm run vault:sync",
    "ensure-wasm": "pnpm --filter ./apps/desktop exec port-kit-ensure-wasm",
    "generate": "node tooling/generate-from-records/generate-from-records.mjs",
    "generate:check": "node tooling/generate-from-records/generate-from-records.mjs --check",
    "generate:enum-types": "node tooling/generate-enum-types/generate-enum-types-cli.mjs",
    "generate:gba-asset-index": "node tooling/generate-gba-asset-index/generate-gba-asset-index-cli.mjs",
    "generate:gba-asset-index:check": "node tooling/generate-gba-asset-index/generate-gba-asset-index-cli.mjs --check",
    "gba:extract-palace": "tsx tooling/gba-alttp-re/export-palace-dungeon.ts",
    "gba:build-playable-assets": "tsx tooling/gba-alttp-re/build-playable-assets.ts",
    "ensure-apworld": "node tooling/apworld/ensure-apworld.mjs",
    "predev": "pnpm run ensure-wasm && pnpm run ensure-apworld",
    "dev": "pnpm --filter ./apps/desktop dev",
    "prebuild": "pnpm run ensure-wasm && pnpm run ensure-apworld",
    "prebuild:web": "pnpm run ensure-apworld",
    "build": "pnpm --filter ./apps/desktop package",
    "build:apworld": "node tooling/apworld/build-apworld.mjs",
    "logos": "node apps/desktop/public/logos/build.mjs",
    "msul:icon": "node tooling/msul-icon/make-msul-icon.mjs",
    "build:linux": "pnpm run build",
    "preview": "pnpm --filter ./apps/desktop exec electron-vite preview",
    "build:web": "pnpm --filter ./apps/desktop build:web",
    "push:linux": "node tooling/deploy/push-linux.mjs",
    "prepush:android": "pnpm run ensure-apworld",
    "push:android": "node tooling/deploy/push-android.mjs",
    "emulator:start": "node tooling/deploy/push-android.mjs --emulator-only",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "standards test",
    "test:pr": "standards test pr",
    "test:e2e": "standards test e2e",
    "lint": "standards lint",
    "lint:all": "standards lint --all",
    "sync:check": "node tooling/sync-check/index.mjs",
    "state-format": "node tooling/state-format/check-state-format.mjs",
    "ci": "pnpm run lint:all && pnpm run state-format && node tooling/analyze/analyze.mjs --ci",
    "analyze": "node tooling/analyze/analyze.mjs --json",
    "analyze:diff": "node tooling/analyze/analyze.mjs --diff",
    "analyze:ci": "node tooling/analyze/analyze.mjs --diff --ci",
    "analyze:tag": "node tooling/analyze/analyze.mjs --fix-tags",
    "clean": "rimraf dist release",
    "version:patch": "pnpm version patch --no-git-tag-version",
    "version:minor": "pnpm version minor --no-git-tag-version",
    "version:major": "pnpm version major --no-git-tag-version",
    "vault:sync": "node tooling/vault/sync.mjs",
    "vault:status": "node tooling/vault/sync.mjs --status",
    "vault:force-pull": "node tooling/vault/sync.mjs --force-pull",
    "vault:force-push": "node tooling/vault/sync.mjs --force-push",
    "safety": "node tooling/safety/cli.mjs",
    "lint:md": "markdownlint-cli2",
    "structure": "brock structure --check",
    "prose": "brock prose",
    "deadcode": "brock knip",
    "duplicates": "jscpd ."
  },
  "devDependencies": {
    "@drizztdourden08/brock-build": "catalog:",
    "@drizztdourden08/brock-lint-config": "catalog:",
    "@drizztdourden08/brock-plugin-snes": "catalog:",
    "@drizztdourden08/brock-thread": "catalog:",
    "@drizztdourden08/standards": "^0.14.2",
    "@drizztdourden08/tessera": "catalog:",
    "@playwright/test": "^1.60.0",
    "@rotp/game-core": "workspace:*",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "clang-format-node": "4.0.2",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "eslint": "catalog:",
    "jscpd": "catalog:",
    "jsdom": "^29.1.1",
    "knip": "catalog:",
    "markdownlint-cli2": "catalog:",
    "rimraf": "^6.1.3",
    "stylelint": "catalog:",
    "stylelint-config-standard": "catalog:",
    "tsx": "^4.23.12",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "brock": {
    "version": "0.120.1",
    "tessera": "0.93.2"
  },
  "bin": {
    "rotp": "./bin/rotp.mjs"
  }
}
