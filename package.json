{
  "name": "relic-of-the-past",
  "version": "0.8.6",
  "private": true,
  "description": "Relic of the Past – Electron + React + WASM",
  "author": {
    "name": "drizztdourden_",
    "email": "drizztdourden08@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/drizztdourden08/relic-of-the-past.git"
  },
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "ensure-electron": "node scripts/ensure-electron.mjs",
    "ensure-wasm": "node scripts/ensure-wasm.mjs",
    "predev": "node scripts/ensure-electron.mjs && node scripts/ensure-wasm.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/ensure-electron.mjs && node scripts/ensure-wasm.mjs",
    "build": "rimraf dist release && electron-vite build && electron-builder --win --config scripts/build/electron-builder.config.js -c.directories.output=release && rimraf dist release/win-unpacked release/builder-debug.yml release/builder-effective-config.yaml",
    "prebuild:win": "node scripts/ensure-electron.mjs && node scripts/ensure-wasm.mjs",
    "build:win": "rimraf dist release && electron-vite build && electron-builder --win --config scripts/build/electron-builder.config.js -c.directories.output=release && rimraf dist release/win-unpacked release/builder-debug.yml release/builder-effective-config.yaml",
    "preview": "electron-vite preview",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "tsc --noEmit && eslint .",
    "gate": "node scripts/copyright-gate/scan.mjs --staged",
    "ci": "npm run lint && node scripts/analyze/analyze.mjs --ci",
    "analyze": "node scripts/analyze/analyze.mjs --json",
    "analyze:diff": "node scripts/analyze/analyze.mjs --diff",
    "analyze:ci": "node scripts/analyze/analyze.mjs --diff --ci",
    "analyze:tag": "node scripts/analyze/analyze.mjs --fix-tags",
    "report": "node scripts/analyze/analyze.mjs --json && node scripts/analyze/reports.mjs all",
    "report:html": "node scripts/analyze/analyze.mjs --json && node scripts/analyze/reports.mjs html",
    "report:structure": "node scripts/analyze/analyze.mjs --json && node scripts/analyze/reports.mjs structure",
    "report:tokens": "node scripts/analyze/analyze.mjs --json && node scripts/analyze/reports.mjs tokens",
    "clean": "rimraf dist release",
    "release": "node scripts/release.mjs",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@iconify-icons/game-icons": "^1.2.1",
    "@iconify/react": "^6.0.2",
    "electron-updater": "^6.8.3",
    "js-yaml": "^4.1.1",
    "marked": "^18.0.4",
    "node-hid": "^3.3.0",
    "node-stream-zip": "^1.15.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "usb": "^2.17.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node-hid": "^1.3.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "astral-regex": "^2.0.0",
    "clang-format": "^1.8.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "markdownlint-cli2": "^0.22.1",
    "playwright": "^1.60.0",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2",
    "rimraf": "^6.1.3",
    "sharp": "^0.34.5",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.3.3",
    "vitest": "^4.1.7"
  }
}
