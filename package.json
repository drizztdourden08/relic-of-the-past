{
  "name": "@rotp/workspace",
  "version": "0.20.7",
  "private": true,
  "description": "Relic of the Past, built with Electron, React and WASM",
  "author": {
    "name": "drizztdourden_",
    "email": "drizztdourden08@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/drizztdourden08/relic-of-the-past.git"
  },
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=24"
  },
  "config": {
    "emsdk": "5.0.7"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs && pnpm run vault:sync",
    "ensure-electron": "node scripts/ensure-electron.mjs",
    "ensure-wasm": "pnpm --filter ./apps/desktop exec port-kit-ensure-wasm",
    "generate": "node scripts/generate-from-records.mjs",
    "generate:check": "node scripts/generate-from-records.mjs --check",
    "generate:enum-types": "node scripts/generate-enum-types-cli.mjs",
    "generate:gba-asset-index": "node scripts/generate-gba-asset-index-cli.mjs",
    "generate:gba-asset-index:check": "node scripts/generate-gba-asset-index-cli.mjs --check",
    "gba:extract-palace": "tsx scripts/gba-alttp-re/export-palace-dungeon.ts",
    "gba:build-playable-assets": "tsx scripts/gba-alttp-re/build-playable-assets.ts",
    "predev": "node scripts/ensure-electron.mjs && pnpm run ensure-wasm",
    "dev": "pnpm --filter ./apps/desktop dev",
    "prebuild": "node scripts/ensure-electron.mjs && pnpm run ensure-wasm",
    "build": "pnpm run build:win",
    "logos": "node apps/desktop/public/logos/build.mjs",
    "msul:icon": "node scripts/build/make-msul-icon.mjs",
    "prebuild:win": "node scripts/ensure-electron.mjs && pnpm run ensure-wasm",
    "build:win": "rimraf apps/desktop/dist release && pnpm --filter ./apps/desktop build && electron-builder --projectDir apps/desktop --win --dir --config ../../scripts/build/electron-builder.config.js -c.directories.output=../../release && pnpm run pack:win",
    "pack:win": "node scripts/build/pack-velopack.mjs",
    "splash:installer": "node scripts/build/make-installer-splash.mjs",
    "prebuild:linux": "node scripts/ensure-electron.mjs && pnpm run ensure-wasm",
    "build:linux": "rimraf apps/desktop/dist release && pnpm --filter ./apps/desktop build && electron-builder --projectDir apps/desktop --linux --config ../../scripts/build/electron-builder.config.js -c.directories.output=../../release",
    "preview": "pnpm --filter ./apps/desktop exec electron-vite preview",
    "build:web": "pnpm --filter ./apps/desktop build:web",
    "sanctuary:dev": "vite -c apps/sanctuary/vite.config.ts --configLoader runner",
    "sanctuary:api": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cloud-functions/sanctuary-api/dev-server.mjs",
    "sanctuary:build": "vite build -c apps/sanctuary/vite.config.ts --configLoader runner",
    "store:dev": "vite -c apps/store/vite.config.ts",
    "store:build": "vite build -c apps/store/vite.config.ts",
    "push:linux": "node scripts/deploy/push-linux.mjs",
    "push:android": "node scripts/deploy/push-android.mjs",
    "emulator:start": "node scripts/deploy/push-android.mjs --emulator-only",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "tsc --noEmit && eslint .",
    "sync:check": "node scripts/hooks/sync-check/index.mjs",
    "state-format": "node scripts/build/check-state-format.mjs",
    "ci": "pnpm run lint && pnpm run state-format &&node scripts/analyze/analyze.mjs --ci",
    "analyze": "node scripts/analyze/analyze.mjs --json",
    "analyze:diff": "node scripts/analyze/analyze.mjs --diff",
    "analyze:ci": "node scripts/analyze/analyze.mjs --diff --ci",
    "analyze:tag": "node scripts/analyze/analyze.mjs --fix-tags",
    "report": "node scripts/analyze/analyze.mjs --json && node scripts/analyze/reports.mjs all",
    "report:html": "node scripts/analyze/analyze.mjs --json && node scripts/analyze/reports.mjs html",
    "report:structure": "node scripts/analyze/analyze.mjs --json && node scripts/analyze/reports.mjs structure",
    "report:tokens": "node scripts/analyze/analyze.mjs --json && node scripts/analyze/reports.mjs tokens",
    "clean": "rimraf dist release",
    "release": "node scripts/release.mjs",
    "release:last": "node scripts/release.mjs --last --latest",
    "version:patch": "pnpm version patch --no-git-tag-version",
    "version:minor": "pnpm version minor --no-git-tag-version",
    "version:major": "pnpm version major --no-git-tag-version",
    "wt": "node scripts/parallel/wt.mjs",
    "wt:list": "node scripts/parallel/wt.mjs list",
    "wt:new": "node scripts/parallel/wt.mjs new",
    "vault:sync": "node scripts/vault/sync.mjs",
    "vault:status": "node scripts/vault/sync.mjs --status",
    "vault:force-pull": "node scripts/vault/sync.mjs --force-pull",
    "vault:force-push": "node scripts/vault/sync.mjs --force-push",
    "safety": "node scripts/safety/cli.mjs",
    "lint:md": "markdownlint-cli2",
    "structure": "brock structure --check",
    "prose": "brock prose",
    "deadcode": "brock knip",
    "duplicates": "jscpd ."
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "catalog:",
    "@capacitor/android": "catalog:",
    "@capacitor/app": "catalog:",
    "@capacitor/core": "catalog:",
    "@capacitor/filesystem": "catalog:",
    "@capacitor/haptics": "catalog:",
    "@capawesome/capacitor-file-picker": "catalog:",
    "@electron-toolkit/utils": "catalog:",
    "@iconify-icons/game-icons": "^1.2.1",
    "@iconify-icons/logos": "^1.2.37",
    "@iconify-icons/lucide": "^1.2.135",
    "@iconify-icons/simple-icons": "^1.2.75",
    "@iconify/react": "^6.0.2",
    "@tiptap/core": "^3.30.2",
    "@tiptap/extension-document": "^3.30.2",
    "@tiptap/extension-paragraph": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/extension-text": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "expr-eval": "2.0.2",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "koffi": "^3.1.2",
    "marked": "^18.0.4",
    "node-stream-zip": "^1.15.0",
    "pngjs": "catalog:",
    "prism-react-renderer": "^2.4.1",
    "react": "catalog:",
    "react-color": "^2.19.3",
    "react-dom": "catalog:",
    "velopack": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "catalog:",
    "@drizztdourden08/brock-build": "catalog:",
    "@drizztdourden08/brock-core": "^0.36.0",
    "@drizztdourden08/brock-lint-config": "catalog:",
    "@drizztdourden08/brock-plugin-snes": "catalog:",
    "@drizztdourden08/brock-thread": "catalog:",
    "@drizztdourden08/tessera": "catalog:",
    "@iconify/types": "^2.0.0",
    "@playwright/test": "^1.60.0",
    "@rotp/asset-extraction": "workspace:*",
    "@rotp/features": "workspace:*",
    "@rotp/game-core": "workspace:*",
    "@rotp/game-data": "workspace:*",
    "@rotp/hub-contracts": "workspace:*",
    "@rotp/hud": "workspace:*",
    "@rotp/input-mapping": "workspace:*",
    "@rotp/languages": "workspace:*",
    "@rotp/msu": "workspace:*",
    "@rotp/navigation": "workspace:*",
    "@rotp/packs": "workspace:*",
    "@rotp/randomizer": "workspace:*",
    "@rotp/roms": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "catalog:",
    "@types/pngjs": "^6.0.5",
    "@types/react": "catalog:",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "astral-regex": "^2.0.0",
    "clang-format": "^1.8.0",
    "clang-format-node": "4.0.2",
    "cmake-js": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "jscpd": "catalog:",
    "jsdom": "^29.1.1",
    "knip": "catalog:",
    "markdownlint-cli2": "catalog:",
    "node-addon-api": "catalog:",
    "playwright": "^1.60.0",
    "png-to-ico": "^3.0.1",
    "rcedit": "catalog:",
    "rimraf": "^6.1.3",
    "sharp": "^0.34.5",
    "stylelint": "catalog:",
    "stylelint-config-standard": "catalog:",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.12",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "catalog:"
  },
  "brock": {
    "version": "0.36.0",
    "tessera": "0.30.2"
  },
  "bin": {
    "rotp": "./bin/rotp.mjs"
  }
}
