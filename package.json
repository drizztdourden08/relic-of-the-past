{
  "name": "relic-of-the-past",
  "version": "0.19.0",
  "private": true,
  "description": "Relic of the Past, built with Electron, React and WASM",
  "author": {
    "name": "drizztdourden_",
    "email": "drizztdourden08@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/drizztdourden08/relic-of-the-past.git"
  },
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs && node scripts/ensure-sdl3.mjs && npm run vault:sync",
    "ensure-electron": "node scripts/ensure-electron.mjs",
    "ensure-wasm": "node scripts/ensure-wasm.mjs",
    "ensure-sdl3": "node scripts/ensure-sdl3.mjs",
    "fetch-sdl3": "node scripts/build/fetch-sdl3.mjs",
    "generate:enum-types": "node scripts/generate-enum-types-cli.mjs",
    "predev": "node scripts/ensure-electron.mjs && node scripts/ensure-wasm.mjs && node scripts/ensure-sdl3.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/ensure-electron.mjs && node scripts/ensure-wasm.mjs && node scripts/ensure-sdl3.mjs",
    "build": "npm run build:win",
    "msul:icon": "node scripts/build/make-msul-icon.mjs",
    "prebuild:win": "node scripts/ensure-electron.mjs && node scripts/ensure-wasm.mjs && node scripts/ensure-sdl3.mjs && node scripts/build/make-msul-icon.mjs",
    "build:win": "rimraf dist release && electron-vite build && electron-builder --win --dir --config scripts/build/electron-builder.config.js -c.directories.output=release && npm run pack:win",
    "pack:win": "node scripts/build/pack-velopack.mjs",
    "splash:installer": "node scripts/build/make-installer-splash.mjs",
    "prebuild:linux": "node scripts/ensure-electron.mjs && node scripts/ensure-wasm.mjs && node scripts/ensure-sdl3.mjs && node scripts/build/make-msul-icon.mjs",
    "build:linux": "rimraf dist release && electron-vite build && electron-builder --linux --config scripts/build/electron-builder.config.js -c.directories.output=release",
    "preview": "electron-vite preview",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "assets:android": "cd apps/mobile && npx @capacitor/assets generate --android --iconBackgroundColor=#0f0f12 --splashBackgroundColor=#0f0f12",
    "cap:sync": "npm run build:web && cd apps/mobile && npx cap sync && npx @capacitor/assets generate --android --iconBackgroundColor=#0f0f12 --splashBackgroundColor=#0f0f12",
    "android:open": "cd apps/mobile && npx cap open android",
    "android:run": "npm run cap:sync && cd apps/mobile && npx cap run android",
    "push:linux": "node scripts/deploy/push-linux.mjs",
    "push:android": "node scripts/deploy/push-android.mjs",
    "emulator:start": "node scripts/deploy/push-android.mjs --emulator-only",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "tsc --noEmit && eslint .",
    "gate": "node scripts/copyright-gate/scan.mjs --staged",
    "sync:check": "node scripts/hooks/sync-check/index.mjs",
    "state-format": "node scripts/build/check-state-format.mjs",
    "ci": "npm run lint && npm run state-format && node scripts/analyze/analyze.mjs --ci",
    "analyze": "node scripts/analyze/analyze.mjs --json",
    "analyze:diff": "node scripts/analyze/analyze.mjs --diff",
    "analyze:ci": "node scripts/analyze/analyze.mjs --diff --ci",
    "analyze:tag": "node scripts/analyze/analyze.mjs --fix-tags",
    "report": "node scripts/analyze/analyze.mjs --json && node scripts/analyze/reports.mjs all",
    "report:html": "node scripts/analyze/analyze.mjs --json && node scripts/analyze/reports.mjs html",
    "report:structure": "node scripts/analyze/analyze.mjs --json && node scripts/analyze/reports.mjs structure",
    "report:tokens": "node scripts/analyze/analyze.mjs --json && node scripts/analyze/reports.mjs tokens",
    "clean": "rimraf dist release",
    "release": "node scripts/release.mjs",
    "release:last": "node scripts/release.mjs --last --latest",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "wt": "node scripts/parallel/wt.mjs",
    "wt:list": "node scripts/parallel/wt.mjs list",
    "wt:new": "node scripts/parallel/wt.mjs new",
    "vault:sync": "node scripts/vault/sync.mjs",
    "vault:status": "node scripts/vault/sync.mjs --status",
    "vault:force-pull": "node scripts/vault/sync.mjs --force-pull",
    "vault:force-push": "node scripts/vault/sync.mjs --force-push",
    "safety": "node scripts/safety/cli.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capawesome/capacitor-file-picker": "^8.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@iconify-icons/game-icons": "^1.2.1",
    "@iconify-icons/lucide": "^1.2.135",
    "@iconify/react": "^6.0.2",
    "@tiptap/core": "^3.30.2",
    "@tiptap/extension-document": "^3.30.2",
    "@tiptap/extension-paragraph": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/extension-text": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "koffi": "^3.1.2",
    "marked": "^18.0.4",
    "node-stream-zip": "^1.15.0",
    "pngjs": "^7.0.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.6",
    "react-color": "^2.19.3",
    "react-dom": "^19.2.6",
    "velopack": "^1.2.110-ge826545",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.0",
    "@playwright/test": "^1.60.0",
    "@types/js-yaml": "^4.0.9",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.15",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "astral-regex": "^2.0.0",
    "clang-format": "^1.8.0",
    "cmake-js": "^8.0.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "markdownlint-cli2": "^0.22.1",
    "node-addon-api": "^8.9.1",
    "playwright": "^1.60.0",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2",
    "rimraf": "^6.1.3",
    "sharp": "^0.34.5",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.3.3",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.7"
  }
}
